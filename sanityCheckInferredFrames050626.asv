%% sanityCheckInferredFrames.m
% Visualises predicted keypoints overlaid on video frames.
% Supports sanity-check videos, bad-frame identification, and Label3D
% training file generation.
%
% Workflow:
%   1. Load results and session metadata
%   2. (Optional) Plot model confidence / reprojection diagnostics
%   3. Read video frames for a selected index range
%   4. Overlay posture predictions in View3D
%   5. (Optional) Export a video
%   6. Identify bad frames, correct in Label3D, and save training file

clear; close all; clc;

% ── Paths ────────────────────────────────────────────────────────────────
CODE_PATH   = 'C:\Users\User\Documents\GitHub';
VID_PATH    = 'Z:\Sherry\acquisition\ROS108\ROS108_062526';
% VID_PATH    = 'Z:\Sherry\acquisition\ROS108\ROS108_062526';
CAL_FILE    = 'Z:\Sherry\camera_calibration\092124_camOptArrayDA_XL.mat';
SKEL_FILE   = 'C:\Users\User\Documents\GitHub\bird_pose_tracking\postureNet\posture_skeleton_IL.csv';
SAVE_DIR    = 'Z:\Sherry\poseTrackingXL\training_files\Label3D\';
SAVE_FILE   = 'ROS108_062526';

% ── Load session data ────────────────────────────────────────────────────
load(fullfile(VID_PATH, 'raw_072226.mat'));
% load(fullfile(VID_PATH, 'annotatedSeeds_ROS108_062526_verified.mat'));    % loads annotatedSeeds if needed

addpath(genpath(CODE_PATH));
cd(CODE_PATH);

CAM_NAMES = {'blue_cam', 'green_cam', 'red_cam', 'yellow_cam'};
N_CAMS    = numel(CAM_NAMES);
FPS       = 50;                          % video frame rate (Hz)
frames    = 1:size(results.com_conf, 1);
nFrames   = numel(frames);

[allParams, skeleton] = loadSessionConfig(CAL_FILE, N_CAMS, SKEL_FILE);

% =========================================================================
%% 1.  Diagnostic plots (comment out if not needed)
% =========================================================================
% postureNet keypoint index map (see plotDiagnostics docstring for full list):
%   1=topBeak  2=bottomBeak  3=head      4=neck    5=leftEye   6=rightEye
%   7=leftWing 8=rightWing   9=leftFoot  10=rightFoot
%   11=leftAnkle  12=rightAnkle  13=chest  14=back  15=tail
POSTURE_KP_IDX = [1,2,5,6];           % <-- change to whichever keypoints you want
plotDiagnostics(results, frames, POSTURE_KP_IDX);

% =========================================================================
%% 1b.  Camera usage in winning triangulation triplets
% =========================================================================
% Requires results.posture_tri_cams (tracking run with return_tri_cams=True).
% Every keypoint on every frame is triangulated from 3 of the 4 cameras, so
% with a healthy rig each camera is included in ~75% of triangulations.
% A camera included much less often is being systematically outvoted —
% either it views that keypoint poorly, or its calibration is off.
if isfield(results, 'posture_tri_cams')
    plotTriCamUsage(results.posture_tri_cams, CAM_NAMES);
else
    fprintf(['results.posture_tri_cams not found - rerun tracking with ' ...
             'return_tri_cams=True to enable the camera-usage plot.\n']);
end

% =========================================================================
%% 2.  [optional] Sanity-check video: pick frame range and visualise
% =========================================================================
predIdx = 1000:1200;
predVid = readVideoFrames(VID_PATH, CAM_NAMES, predIdx);

% View in 3-D GUI
close all;
viewGui        = View3D(allParams, predVid, skeleton);
viewGui.defScale = 40;
colormap(viewGui.h{1}.Parent, 'gray');

pts3d_posture = permute(results.posture_preds, [1, 3, 2]);
viewGui.loadFrom3D(pts3d_posture(predIdx + 1, :, :));

% =========================================================================
%% BELOW: haven't checked yet 3.  (Optional) Export video
% =========================================================================
% exportSanityVideo(viewGui, predIdx, fullfile(VID_PATH, 'raw100000_200frames_021826'));

% =========================================================================
%% 4.  Identify bad frames, correct in Label3D, save training file
% =========================================================================
N_SAMPLED     = 60;
NO_TAIL_IDX   = [1:6, 8:15];           % keypoint indices to include in QC metric
REP_ERR_RANGE  = [5 15];               % within [lo hi] gets selected
CONF_THRESH    = 0.8;                  % < conf_thresh gets selected

% Restrict bad-frame QC to two frame pools, each padded independently by a
% user-specified number of seconds before/after:
%   (a) feeder-interaction windows — beak dips into the feeder, tracking often
%       fails there;
%   (b) seed-carry bouts — beak keypoint is often occluded during transport.
FEEDER_SEC_BEFORE = 6;    % seconds before/after each feeder interaction
FEEDER_SEC_AFTER  = 6;
CARRY_SEC_BEFORE  = 6;    % seconds before/after each seed-carry bout
CARRY_SEC_AFTER   = 6;

% Feeder-interaction frames
feederFrames = getFeederInteractionFrames( ...
    annotatedSeeds.countData, nFrames, FEEDER_SEC_BEFORE, FEEDER_SEC_AFTER, FPS);
fprintf('Feeder-interaction QC pool: %d frames from %d interactions (+%.1fs before, %.1fs after).\n', ...
    numel(feederFrames), numel(annotatedSeeds.countData.newFeeder), FEEDER_SEC_BEFORE, FEEDER_SEC_AFTER);

% Seed-carrying frames (bird transporting a seed)
carryFrames = getSeedCarryFrames( ...
    annotatedSeeds, nFrames, CARRY_SEC_BEFORE, CARRY_SEC_AFTER, FPS);
fprintf('Seed-carry QC pool: %d frames (+%.1fs before, %.1fs after).\n', ...
    numel(carryFrames), CARRY_SEC_BEFORE, CARRY_SEC_AFTER);

% Combined QC pool: feeder-interaction + seed-carrying frames
qcFrames = union(feederFrames, carryFrames);
fprintf('Combined QC pool: %d frames.\n', numel(qcFrames));

[sampled_frame_idx] = identifyBadFrames( ...
    results, qcFrames, NO_TAIL_IDX, REP_ERR_RANGE, CONF_THRESH, N_SAMPLED);

bad_videos = readVideoFrames(VID_PATH, CAM_NAMES, sampled_frame_idx);

%% Label3D correction GUI
close all;
pts3d      = permute(results.posture_preds, [1, 3, 2]);
labelGui   = Label3D(allParams, bad_videos, skeleton, 'defScale', 35);
labelGui.loadFrom3D(pts3d(sampled_frame_idx, :, :));
colormap(labelGui.h{1}.Parent, 'gray');

% ── After manual correction, run section below    ───────────────────────────
%% 5.  Save Label3D training file
saveLabelGuiDraft(labelGui, SAVE_DIR, SAVE_FILE);

% =========================================================================
%% 6.  Merge manual corrections with model predictions and save final file
% =========================================================================
% Frames to discard because the bird is not visible in ANY of the 4 camera
% views. These are excluded from the saved training file: their video slices
% and 3D-point rows are dropped together, so `videos` and `data_3D` stay
% aligned (camParams / skeleton are untouched).
%   • Give ABSOLUTE session frame numbers (same numbering as sampled_frame_idx).
%   • To discard by position in the Label3D set (e.g. the 3rd & 5th labelled
%     frames), use:  DISCARD_FRAMES = sampled_frame_idx([3 5]);
%   • Leave empty ([]) to keep every sampled frame.
DISCARD_FRAMES = sampled_frame_idx([29, 30]); % e.g.sampled_frame_idx([3 5])

mergeAndSaveTrainingFile(SAVE_DIR, SAVE_FILE, results, sampled_frame_idx, skeleton, DISCARD_FRAMES);

%%
function sampled_frame_idx = identifyBadFrames( ...
        results, frames, noTailIdx, repErrRange, confThresh, nSampled)
% identifyBadFrames  Flag frames with high reprojection error or low confidence.
%
%   sampled_frame_idx = identifyBadFrames(results, frames, noTailIdx, ...
%                           repErrRange, confThresh, nSampled)
%
%   noTailIdx    – keypoint column indices to include (exclude tail etc.)
%   repErrRange  – [lo hi] median reprojection error window (pixels); frames
%                  with error inside this window are selected. A scalar is
%                  treated as [lo Inf] (old "greater than" behaviour).
%   confThresh   – median confidence threshold (0–1)
%   nSampled     – number of bad frames to sample for Label3D

    if isscalar(repErrRange); repErrRange = [repErrRange Inf]; end

    avg_rep_err = median(results.posture_reproj(frames, noTailIdx), 2);
    avg_conf    = median(results.posture_conf(frames, noTailIdx), 2);

    figure('Name', 'Bad Frame QC Metrics');
    subplot(1,2,1); histogram(avg_rep_err); xlabel('Median Reproj Error');
    subplot(1,2,2); histogram(avg_conf);    xlabel('Median Confidence');

    bad_mask      = (avg_rep_err >= repErrRange(1)) & ...
                    (avg_rep_err <= repErrRange(2)) & (avg_conf < confThresh);
    bad_frame_idx = frames(bad_mask);

    fprintf('Bad frames: %d / %d (%.1f%%)\n', ...
        sum(bad_mask), numel(frames), 100*mean(bad_mask));

    sampled_frame_idx = bad_frame_idx( ...
        round(linspace(1, numel(bad_frame_idx), nSampled)));
end

function exportSanityVideo(viewGui, predIdx, outPath)
% exportSanityVideo  Write View3D frames to an MPEG-4 file.
%
%   exportSanityVideo(viewGui, predIdx, outPath)
%
%   outPath – full path without extension

    v           = VideoWriter(outPath, 'MPEG-4');
    v.Quality   = 95;
    v.FrameRate = 10;
    v.open();
    for i = 1:numel(predIdx)
        viewGui.setFrame(i);
        viewGui.triangulateView();
        viewGui.resetAspectRatio();
        F = getframe(viewGui.Parent);
        v.writeVideo(F.cdata);
    end
    v.close();
    fprintf('Video saved to: %s.mp4\n', outPath);
end

function saveLabelGuiDraft(labelGui, saveDir, saveFile)
% saveLabelGuiDraft  Save the Label3D GUI state before manual correction.
%
%   saveLabelGuiDraft(labelGui, saveDir, saveFile)

    draft = [saveFile '_draft'];
    labelGui.savePath = fullfile(saveDir, draft);
    labelGui.saveAll();
    fprintf('Draft saved to: %s\n', labelGui.savePath);
end

% =========================================================================
function mergeAndSaveTrainingFile(saveDir, saveFile, results, sampledFrameIdx, skeleton, discardFrames)
% mergeAndSaveTrainingFile  Integrate manual corrections with model predictions.
%
%   mergeAndSaveTrainingFile(saveDir, saveFile, results, sampledFrameIdx, skeleton)
%   mergeAndSaveTrainingFile(..., discardFrames)
%
%   Loads the saved draft, overlays manually-corrected points (non-NaN)
%   onto the model predictions, then saves the final training file.
%
%   discardFrames (optional) – ABSOLUTE frame numbers (a subset of
%     sampledFrameIdx) to exclude from the saved file, e.g. frames where the
%     bird is not visible in any camera view. The matching rows of data_3D and
%     the matching slices of every camera's video are dropped together, so
%     videos and data_3D stay aligned; camParams and skeleton are unchanged.
%     Defaults to [] (keep all frames).

    if nargin < 6 || isempty(discardFrames); discardFrames = []; end

    draft = [saveFile '_draft'];
    load(fullfile(saveDir, [draft '_videos.mat']), 'camParams', 'videos', 'data_3D');

    pts3d    = permute(results.posture_preds, [1, 3, 2]);
    bad_pts  = pts3d(sampledFrameIdx, :, :);
    bad_pts  = reshape(bad_pts, size(bad_pts,1), []);       % nFrames × (3×nKP)
    bad_pts(~isnan(data_3D)) = data_3D(~isnan(data_3D));   % apply manual edits

    % Exclude discarded frames (bird not in any view). Drop the matching rows
    % of bad_pts and slices of every video together, keeping them aligned.
    keep = ~ismember(sampledFrameIdx(:), discardFrames(:));
    if any(~keep)
        fprintf('Excluding %d discarded frame(s) from the saved file: %s\n', ...
            sum(~keep), mat2str(reshape(sampledFrameIdx(~keep), 1, [])));
        bad_pts = bad_pts(keep, :);
        for c = 1:numel(videos)
            videos{c} = videos{c}(:, :, :, keep);
        end
    end

    % Review merged result (after exclusion — this is exactly what gets saved)
    close all;
    labelGui = Label3D(camParams, videos, skeleton, 'defScale', 35);
    labelGui.loadFrom3D(bad_pts);
    colormap(labelGui.h{1}.Parent, 'gray');

    data_3D  = bad_pts;
    nFrames  = size(data_3D, 1);
    outName  = sprintf('%snFrame%d_v73_videos', saveFile, nFrames);
    save(fullfile(saveDir, outName), 'camParams', 'videos', 'data_3D', 'skeleton', '-v7.3');
    fprintf('Training file saved: %s (%d frames)\n', fullfile(saveDir, outName), nFrames);
end

% =========================================================================
function plotTriCamUsage(triCams, camNames)
% plotTriCamUsage  Show how often each camera is in the winning triplet.
%
%   plotTriCamUsage(triCams, camNames)
%
%   triCams  – results.posture_tri_cams, nFrames × nKP × 3, 0-BASED camera
%              indices (order of camNames) saved by the Python tracker
%   camNames – cell array of camera names
%
%   Left:  overall fraction of triangulations that include each camera
%          (each triplet uses 3 of the 4 cameras, so balanced usage = 75%).
%   Right: the same fraction broken down per keypoint (rows = cameras).

    camColors = [0    0.45 1   ;   % blue_cam
                 0    0.65 0.15;   % green_cam
                 0.90 0.10 0.10;   % red_cam
                 0.85 0.65 0   ];  % yellow_cam
    kpNames = {'topBeak','bottomBeak','head','neck','leftEye','rightEye', ...
               'leftWing','rightWing','leftFoot','rightFoot','leftAnkle', ...
               'rightAnkle','chest','back','tail'};

    nCams = numel(camNames);
    camLbl = strrep(camNames, '_', '\_');
    tc = double(triCams) + 1;                       % 0-based -> 1-based
    [nF, nKp, ~] = size(tc);
    edges = 0.5 : 1 : nCams + 0.5;

    % overall inclusion fraction per camera
    usage = histcounts(tc(:), edges) / (nF * nKp);

    % per-keypoint inclusion fraction, nCams × nKp
    kpUsage = zeros(nCams, nKp);
    for k = 1:nKp
        kpUsage(:, k) = histcounts(reshape(tc(:, k, :), [], 1), edges) / nF;
    end

    figure('Name', 'Triangulation camera usage');
    subplot(1, 2, 1);
    b = bar(usage, 'FaceColor', 'flat');
    b.CData = camColors(1:nCams, :);
    yline(3/nCams, 'k--', sprintf('balanced (%.0f%%)', 100*3/nCams));
    set(gca, 'XTickLabel', camLbl);
    ylim([0 1]); ylabel('Fraction of triangulations using camera');
    title('Overall camera usage'); grid on;

    subplot(1, 2, 2);
    imagesc(kpUsage); clim([0 1]); colorbar;
    set(gca, 'YTick', 1:nCams, 'YTickLabel', camLbl, ...
             'XTick', 1:nKp, 'XTickLabel', kpNames);
    xtickangle(45);
    title('Camera usage per keypoint (fraction of frames)');

    fprintf('\n─ Triangulation camera usage (balanced = %.0f%%) ─\n', 100*3/nCams);
    for c = 1:nCams
        fprintf('%-12s included in %5.1f%% of triangulations\n', ...
            camNames{c}, 100 * usage(c));
    end
end

